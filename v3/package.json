{
  "name": "wowup",
  "productName": "WowUp",
  "version": "3.0.0-beta.1",
  "private": true,
  "description": "World of Warcraft addon updater",
  "main": "./out/main/index.mjs",
  "author": "example.com",
  "homepage": "https://wowup.io",
  "gypfile": true,
  "keywords": [
    "wow",
    "world of warcraft"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WowUp/WowUp.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && ow-electron-builder install-app-deps",
    "build:clean": "node ./scripts/clean.js",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "ow:dev": "cross-env BUILD_FLAVOR=ow npm run dev",
    "ow:build:win": "cross-env BUILD_FLAVOR=ow npm run build && npm run build:clean && ow-electron-builder --win -c ./electron-builder-ow.yml",
    "wago:dev": "cross-env BUILD_FLAVOR=wago npm run dev",
    "wago:build:win": "cross-env BUILD_FLAVOR=wago npm run build && npm run build:clean && electron-builder --win -c ./electron-builder-wago.yml"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "electron-updater": "^6.1.7",
    "inversify": "^6.2.1",
    "lowdb": "^7.0.1",
    "node-disk-info": "^1.3.0",
    "protobufjs": "^7.4.0",
    "reflect-metadata": "^0.2.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@overwolf/ow-electron": "^31.7.3",
    "@overwolf/ow-electron-builder": "^25.0.6",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/string-similarity": "^4.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "ag-grid-react": "^33.0.3",
    "antd": "^5.22.7",
    "cross-env": "^7.0.3",
    "curseforge-v2": "^1.3.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.2.4",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "lodash": "^4.17.21",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "string-similarity": "^4.0.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "zustand": "^5.0.2"
  }
}